 "html": "<div class=\"report-container\" style=\"width: 100%; font-family: Arial, sans-serif; border: 1px solid black;\">\n\n    <div class=\"header-info\" style=\"border-bottom: 1px solid black;\">\n        <div style=\"float:left; padding:10px;\">\n            {% if doc.company %}\n                {% set company = frappe.get_doc(\"Company\", doc.company) %}\n                {% if company.company_logo %}\n                    <img src=\"{{ company.company_logo }}\" style=\"width: auto; height: 50px;\">\n                {% endif %}\n            {% endif %}\n        </div>\n        <p style=\"text-align:center; margin-top:0px; padding-top: 15px;\">\n            <span style=\"font-size:20px; font-weight:bold;\">\n                {% if doc.custom_order_type == \"Purchase\" %} PURCHASE ORDER\n                {% elif doc.custom_order_type == \"Service Order\" %} SERVICE ORDER\n                {% elif doc.custom_order_type == \"Work Order\" %} WORK ORDER\n                {% endif %}\n                ({{ doc.company }})\n            </span>\n        </p>\n\n        <div style=\"display: flex; font-size: 10px; border-top: 1px solid black;\">\n            <div style=\"width: 50%; padding: 5px; border-right: 1px solid black;\">\n                {% if doc.billing_address %}\n                    {% set address = frappe.get_doc(\"Address\", doc.billing_address) %}\n                    <strong>Invoice To:</strong> <span>{{ doc.company }}</span>\n                    <p style=\"margin:5px 0;\">\n                        {{ address.address_line1 }}, {{ address.city }} - {{ address.pincode }}, {{ address.state }}\n                    </p>\n                {% endif %}\n                <b>GSTIN:</b> {{ company.gstin if company.gstin else '' }}\n            </div>\n            <div style=\"width: 50%; padding: 5px;\">\n                <p style=\"margin:2px 0;\"><b>LOI No.:</b> {{ doc.name }}</p>\n                <p style=\"margin:2px 0;\"><b>LOI Date:</b> {{ doc.get_formatted(\"transaction_date\") }}</p>\n                <p style=\"margin:2px 0;\"><b>Payment Terms:</b> {{ doc.payment_terms_template }}</p>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"main-content\">\n        <div style=\"display: flex; font-size: 10px; border-bottom: 1px solid black;\">\n            <div style=\"width: 50%; padding: 5px; border-right: 1px solid black;\">\n                <strong>Supplier Name & Address</strong><br>\n                <b>{{ doc.supplier_name }}</b><br>\n                {{ doc.address_display }}\n            </div>\n            <div style=\"width: 50%; padding: 5px;\">\n                <strong>Terms & Conditions</strong><br>\n                {{ doc.terms or '' }}\n            </div>\n        </div>\n\n        <table style=\"width:100%; border-collapse: collapse; margin:0;\">\n            <thead>\n                <tr style=\"background-color: #f2f2f2;\">\n                    <th style=\"border:1px solid black; padding:5px; font-size:11px;\">SR.No</th>\n                    <th style=\"border:1px solid black; padding:5px; font-size:11px;\">Item + Description</th>\n                    <th style=\"border:1px solid black; padding:5px; font-size:11px;\">Qty</th>\n                    <th style=\"border:1px solid black; padding:5px; font-size:11px;\">Rate</th>\n                    <th style=\"border:1px solid black; padding:5px; font-size:11px;\">SR.No</th>\n                    <th style=\"border:1px solid black; padding:5px; font-size:11px;\">Item + Description</th>\n                    <th style=\"border:1px solid black; padding:5px; font-size:11px;\">Qty</th>\n                    <th style=\"border:1px solid black; padding:5px; font-size:11px;\">Rate</th>\n                    <th style=\"border:1px solid black; padding:5px; font-size:11px;\">Amount</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% set totals = namespace(subtotal=0) %}\n                {% for row in doc.items %}\n                <tr>\n                    <td style=\"border:1px solid black; text-align:center; padding:5px;\">{{ loop.index }}</td>\n                    <td style=\"border:1px solid black; padding:5px;\">\n                        <b>{{ row.item_name }}</b><br><small>{{ row.description }}</small>\n                    </td>\n                    <td style=\"border:1px solid black; text-align:right; padding:5px;\">{{ row.qty }}</td>\n                    <td style=\"border:1px solid black; text-align:right; padding:5px;\">{{ row.get_formatted(\"rate\", doc) }}</td>\n                    <td style=\"border:1px solid black; text-align:right; padding:5px;\"></td>\n                    <td style=\"border:1px solid black; text-align:right; padding:5px;\"></td>\n                    <td style=\"border:1px solid black; text-align:right; padding:5px;\">{{ row.qty }}</td>\n                    <td style=\"border:1px solid black; text-align:right; padding:5px;\">{{ row.get_formatted(\"rate\", doc) }}</td>\n                    <td style=\"border:1px solid black; text-align:right; padding:5px;\">\n                        {{ row.get_formatted(\"amount\", doc) }}\n                        {% set totals.subtotal = totals.subtotal + row.amount %}\n                    </td>\n                </tr>\n                {% endfor %}\n                <tr>\n                    <td colspan=\"8\" style=\"border:1px solid black; text-align:right; padding:5px;\"><b>Grand Total</b></td>\n                    <td style=\"border:1px solid black; text-align:right; padding:5px;\"><b>{{ frappe.format_value(totals.subtotal, {\"fieldtype\": \"Currency\", \"options\": doc.currency}) }}</b></td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n\n    <div class=\"footer-info\" style=\"border-top: 1px solid black; font-size: 10px; page-break-inside: avoid;\">\n        <div style=\"padding: 5px; border-bottom: 1px solid black;\">\n            <b>Amount in Words:</b> <span style=\"text-transform: uppercase;\">{{ doc.in_words }}</span>\n        </div>\n        <div style=\"display: flex;\">\n            <div style=\"width: 50%; padding: 5px; border-right: 1px solid black;\">\n                <p><b>Prepared By:</b> {{ frappe.get_doc(\"User\", doc.owner).full_name }}</p>\n                <p><b>Approved By:</b> _________________</p>\n            </div>\n            <div style=\"width: 50%; padding: 5px; text-align: center;\">\n                <p>Scan for Location</p>\n                {% if company.custom_qr_code %}\n                    <img src=\"{{ company.custom_qr_code }}\" style=\"width: 80px; height: 80px;\">\n                {% endif %}\n            </div>\n        </div>\n    </div>\n</div>",
